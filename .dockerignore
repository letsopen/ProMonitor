# 依赖与构建产物（容器内会重新安装/构建）
node_modules
.gotool
# 注意：bin/ 与 dist/ 不再忽略——均由 CI 构建产出后下载进构建上下文，
# 由 Dockerfile 直接 COPY（bin/ 存 Go 静态二进制、dist/ 存前端产物）。
# bin/ 与 dist/ 本身仍由 .gitignore 排除、不入库。

# 本地数据、日志、环境变量
*.db
*.db-shm
*.db-wal
smoke*.log
.env
.env.local

# 文档与脚本（无需进入镜像）
README.md
AGENTS.md
docs
scripts/smoke.mjs

# 版本控制
.git
.gitignore

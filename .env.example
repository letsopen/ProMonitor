# Docker / docker-compose 部署用的环境变量示例
# 用法：复制为 .env 后填入真实值：cp .env.example .env

# 必填：被控上报的 HMAC 预共享密钥（主控与被控必须一致）
HMAC_SECRET=please-change-this-to-a-long-random-secret

# 可选：首次启动以此密码初始化管理员 admin（留空则不初始化，需手动进容器创建）
ADMIN_PASS=please-change-admin-password

# 可选：会话签名密钥（留空则用镜像内置默认值，建议改成随机串）
SESSION_SECRET=please-change-session-secret

# 可选：网络延迟探测配置（被控通过 /api/ping-config 拉取，无需在被控侧配置）
# 探测方式：tcp（默认，TCP 端口探测）或 icmp（需容器 --cap-add NET_RAW）
PING_METHOD=tcp
# method=tcp 时的探测端口
PING_PORT=80
# 逗号分隔的探测节点清单（最多 50 个），为空则被控无延迟数据
PING_NODES=8.8.8.8,1.1.1.1,9.9.9.9

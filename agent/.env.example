# 被控 Agent 环境变量示例（复制为 .env 或直接 export）
# 必填项：HMAC_SECRET、SERVER_ID

# 主控地址（http://主控IP:9000）
MASTER_URL=http://localhost:9000

# 与主控 HMAC_SECRET 一致的预共享密钥
HMAC_SECRET=change-me-shared-secret

# 被控唯一 ID（与管理页添加的"被控 ID"保持一致）
SERVER_ID=server-01

# 展示名（默认同 SERVER_ID）
SERVER_NAME=阿里云-杭州

# 被控 IP（可选，仅展示用）
SERVER_IP=1.2.3.4

# 可选回退：探测节点由主控通过 /api/ping-config 统一下发，无需在此配置；
# 仅当主控未配置任何节点时，此处的逗号分隔列表才会被使用（最多 50 个）
PING_TARGETS=114.114.114.114,223.5.5.5,8.8.8.8

# 实时采集间隔（秒），默认 30，最低 30，必须是 30 的倍数
COLLECT_INTERVAL=30

# 本地持久化历史聚合记录的数据库路径（默认 agent.db）
# DB_PATH=agent.db

# 调试模式：true/1/on 或空值时打印所有收发报文（JSON 美化），false/0/off 关闭
# DEBUG=true

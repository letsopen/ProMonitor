# 主控服务端环境变量示例（复制为 .env 或直接 export）
# 必填项：HMAC_SECRET、ADMIN_PASS

# SQLite 文件路径（默认 ./promonitor.db，相对启动目录）
DB_PATH=./promonitor.db

# 被控上报验签密钥（与 agent 端 HMAC_SECRET 必须一致）
HMAC_SECRET=change-me-shared-secret

# 管理员用户名（默认 admin）
ADMIN_USER=admin

# 首次启动时写入的种子管理员密码（之后可在管理页修改）
ADMIN_PASS=change-me-admin-pass

# 会话 Cookie 签名密钥（请改为随机长字符串）
SESSION_SECRET=change-me-session-secret

# 监听端口（默认 9000）
PORT=9000

# 前端静态目录（默认 ./dist，由 vite build 产出）
FRONTEND_DIR=./dist

# 可选：网络延迟探测方式（tcp/icmp）。节点清单已改在管理后台维护，
# 被控通过 /api/ping-config 拉取，无需在环境变量配置。
PING_TYPE=tcp
